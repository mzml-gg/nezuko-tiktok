{
  "name": "nezuko-tiktok",
  "version": "1.1.0",
  "description": "Modern ESM Node.js client for the omkarcloud TikTok Scraper API, including video search.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/client.test.js",
    "test:live": "node --test test/live-search.test.js",
    "lint": "node --check src/index.js && node --check src/errors.js"
  },
  "keywords": [
    "tiktok",
    "scraper",
    "search",
    "api",
    "esm",
    "nodejs"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mzml-gg/nezuko-tiktok.git"
  },
  "bugs": {
    "url": "https://github.com/mzml-gg/nezuko-tiktok/issues"
  },
  "license": "MIT",
  "author": "mzml-gg"
}
